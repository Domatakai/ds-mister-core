		ram[18'h0148] = 32'h3660463E;  // 02000520  mov r6, r7 ; adds r6, #0x60
		ram[18'h0149] = 32'h22002100;  // 02000524  movs r1, #0 ; movs r2, #0
		ram[18'h014A] = 32'h64B9CE06;  // 02000528  ldmia r6!, {r1, r2} ; str r1, [r7, #0x48]
		ram[18'h014B] = 32'h205A64FA;  // 0200052C  str r2, [r7, #0x4c] ; movs r0, #0x5a
		ram[18'h014C] = 32'h4B0167F8;  // 02000530  str r0, [r7, #0x7c] ; ldr r3, [pc, #4]
		ram[18'h014D] = 32'hBF004718;  // 02000534  bx r3 ; nop
		ram[18'h014E] = 32'h0200053F;  // 02000538  .word end_e+1 (0x0200053F)
		ram[18'h014F] = 32'hE7FE0000;  // 0200053C  b {end_e}
	end
endtask

// the exception vectors: return from the exception (CPSR <- SPSR)
task load_vectors;
	begin
		lo[14'h0001] = 32'hE1B0F00E;   // 00000004
		lo[14'h0002] = 32'hE1B0F00E;   // 00000008
		lo[14'h0003] = 32'hE1B0F00E;   // 0000000C
		hi[14'h0001] = 32'hE1B0F00E;   // 00000004
		hi[14'h0002] = 32'hE1B0F00E;   // 00000008
		hi[14'h0003] = 32'hE1B0F00E;   // 0000000C
		hi[14'h0006] = 32'hE1B0F00E;   // 00000018
	end
endtask
