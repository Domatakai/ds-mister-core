-	.mnt_cmd(d_mnt_cmd),
-	.mnt_arg(cp15_c7_arg),
+	.mnt(d_mnt || cp15_tc[1] || sn_now),
+	.mnt_cmd(sn_now ? 4'd2 : d_mnt_cmd),
+	.mnt_arg(sn_now ? sn_line : cp15_c7_arg),
 	.lock_way(c9_lock_d[1:0]),
 	.lock_en(c9_lock_d[31]),
 	.dirty_any(d_tag_dirty),
 	.hit_now(tag_hit),
 	.way_now(tag_way),
 	.last_hit(),
@@ -1161,20 +1177,18 @@
