set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/engine_a.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/engine_b.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/vram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/geometry_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/raster_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/arm9_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/arm7_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/bus/main_bus.sv
