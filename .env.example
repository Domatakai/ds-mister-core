# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Archil persistent disk (https://docs.archil.com/sdks/typescript)
# Account API key from the Archil dashboard. Server-side only: read by the
# Convex actions in src/convex/archil.ts, never exposed to the browser.
ARCHIL_API_KEY=

# Optional: disk holding the OSD profile snapshot (default nds-mister-core)
ARCHIL_DISK_NAME=

# Optional: Archil region - aws-us-east-1, aws-us-west-2, aws-eu-west-1, gcp-us-central1
ARCHIL_REGION=